{
  "name": "mmm-forum",
  "version": "1.1.1",
  "description": "A MagicMirror² module to display information from the MagicMirror² forum.",
  "type": "commonjs",
  "keywords": [
    "MagicMirror",
    "forum",
    "NodeBB"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KristjanESPERANTO/MMM-Forum.git"
  },
  "license": "ISC",
  "author": "Kristjan ESPERANTO (https://github.com/KristjanESPERANTO)",
  "main": "MMM-Forum.js",
  "scripts": {
    "demo": "cd ../../ && MM_CONFIG_FILE=modules/MMM-Forum/demo.config.js node --run start:dev",
    "lint": "eslint && prettier . --check",
    "lint:fix": "eslint --fix && prettier . --write",
    "prepare": "simple-git-hooks || true",
    "release": "commit-and-tag-version --config ./changelog.config.js",
    "test": "node --run lint && node --run test:spelling && node --run test:unit",
    "test:spelling": "cspell .",
    "test:unit": "node --test"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "commit-and-tag-version": "^13.2.1",
    "cspell": "^10.3.6",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.12.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true,
    "unrs-resolver@1.12.2": true
  }
}
